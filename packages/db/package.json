{
  "name": "@rentanllm/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./sync": "./src/sync.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:integration": "DATABASE_URL=postgres://rentanllm:rentanllm@localhost:54329/rentanllm vitest run",
    "db:sync": "bun src/sync-cli.ts",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down -v"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.6",
    "@rentanllm/core": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.5",
    "vitest": "5.0.5"
  }
}
