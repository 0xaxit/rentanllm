{
  "name": "@rentanllm/mcp",
  "version": "0.0.1",
  "private": true,
  "description": "MCP server that lets an agent buy inference on the RentAnLLM market, with Touch ID approval for every payment.",
  "bin": {
    "rentanllm-mcp": "./src/main.ts"
  },
  "type": "module",
  "exports": {
    "./remote": "./src/remote.ts"
  },
  "scripts": {
    "build:signer": "swiftc -O signer/main.swift -o dist/rentanllm-signer -framework LocalAuthentication -framework Security",
    "dev": "bun src/main.ts",
    "typecheck": "tsc -p .",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@x402/core": "2.28.0",
    "@x402/hedera": "2.28.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
