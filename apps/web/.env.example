# Control-plane API (apps/api) origin. Server-only: the browser never calls it
# directly; next.config.ts rewrites /api/* on this app's own host to it (read at
# build time), and Server Components call it at runtime, forwarding the cookie.
# Default: http://localhost:8788
# Production (Vercel): https://rentanllm-api.vercel.app
API_ORIGIN=
# Optional server-side override for Server Component fetches only (e.g. a
# private address). Defaults to API_ORIGIN.
API_URL=

# Gateway (apps/gateway). Renters' base URL is this + /v1; the node command
# uses wss://<host>/tunnel. Default: http://localhost:8787
# Production (Hostinger, sslip.io until there is a domain): https://gw.203-0-113-7.sslip.io
NEXT_PUBLIC_GATEWAY_URL=

# Optional. Hedera testnet JSON-RPC for the wallet. Defaults to viem's public endpoint (Hashio).
NEXT_PUBLIC_HEDERA_RPC_URL=

# Optional. WalletConnect Cloud project id (https://cloud.reown.com).
# Without it the Connect Wallet modal offers browser (injected) wallets and
# Coinbase Wallet only; QR / mobile wallets via WalletConnect are disabled.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical origin for Open Graph URLs and WalletConnect metadata.
# Default: https://rentanllm.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional. Grafana Faro browser telemetry; off when empty.
# Production: https://otel.203-0-113-7.sslip.io/collect
NEXT_PUBLIC_FARO_URL=
# Alloy's FARO_APP_KEY (deploy/hostinger/.env). Public by design, not a secret.
NEXT_PUBLIC_FARO_APP_KEY=
# Default: production
NEXT_PUBLIC_FARO_ENV=
