# Local development (`bun dev`). Copied to .env.dev on first run (gitignored),
# with SESSION_SECRET and CRON_SECRET generated. Market payments use Hedera testnet.

# Local Postgres + Redis from packages/db/docker-compose.dev.yml
DATABASE_URL=postgres://rentanllm:rentanllm@localhost:54329/rentanllm
REDIS_URL=redis://localhost:56379

# API (apps/api) on :8788, gateway (apps/gateway) on :8787, web on :3000
SESSION_SECRET=
CRON_SECRET=
SIWE_DOMAIN=localhost:3000
WEB_ORIGINS=http://localhost:3000
STORE=postgres
GATEWAY_PUBLIC_URL=http://localhost:8787
API_ORIGIN=http://localhost:8788
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hedera testnet: agents pay sellers in USDC (0.0.429274) through the x402 facilitator.
# Optional: Hedera JSON-RPC for smart-wallet sign-in (ERC-1271).
HEDERA_RPC_URL=https://testnet.hashio.io/api

# How often the local scheduler calls /cron/tick (marks silent nodes offline).
DEV_TICK_SECONDS=60

# Arkiv (Rabdi testnet): the gateway mirrors market offers and receipts there.
# Empty key leaves Arkiv out. Fund the writer with tGLM: https://hub.arkiv.network/faucet
ARKIV_PRIVATE_KEY=
# Free key from https://hub.arkiv.network/access-keys; empty uses the rate-limited public RPC.
ARKIV_ACCESS_KEY=
# The writer's address; the web's market page reads only this writer's entities.
ARKIV_WRITER_ADDRESS=
