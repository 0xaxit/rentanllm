# Copy to .env next to compose.yaml and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32

# Base domain; Caddy serves gw.<DOMAIN>, otel.<DOMAIN> and grafana.<DOMAIN>.
# Current setup, no domain needed: <VPS IPv4 with dashes>.sslip.io. sslip.io
# resolves gw.203-0-113-7.sslip.io to 203.0.113.7, and Let's Encrypt issues real
# certificates for it. Replace 203-0-113-7 with your VPS IP.
# Later, with a domain: DOMAIN=rentanllm.xyz and A/AAAA records for gw., otel., grafana.
# Use DOMAIN=localhost for a local test run (Caddy then issues internal certs).
DOMAIN=203-0-113-7.sslip.io
# Who terminates TLS on 80/443:
#   caddy   (default) this stack's Caddy publishes 80/443 and gets certificates itself.
#   traefik an existing Traefik on the host already owns 80/443; Caddy joins its
#           Docker network unpublished and Traefik routes gw./otel./grafana. to it.
EDGE_MODE=caddy
# Only for EDGE_MODE=traefik: Traefik's Docker network and certificate resolver.
TRAEFIK_NETWORK=root_default
TRAEFIK_CERT_RESOLVER=mytlschallenge
# Let's Encrypt account email.
ACME_EMAIL=ops@example.com

# Gateway image. Leave as rentanllm-gateway:local to build on the box (deploy.sh --build),
# or point at GHCR, e.g. ghcr.io/<owner>/rentanllm-gateway:main or :v0.1.0
GATEWAY_IMAGE=ghcr.io/OWNER/rentanllm-gateway:main
DEPLOY_ENV=production
# Gateway app settings and secrets go in gateway.env (see gateway.env.example).

# Redis (internal network only).
REDIS_PASSWORD=change-me-redis-password

# Bearer token Vercel functions send to https://otel.<DOMAIN>.
OTEL_INGEST_TOKEN=change-me-otel-ingest-token

# Faro browser telemetry at https://otel.<DOMAIN>/collect. Browsers cannot keep a
# secret, so this is not a token: Caddy forwards only requests whose Origin is
# FARO_ALLOWED_ORIGIN, and Alloy checks the app key, which is public (the web
# app ships it as NEXT_PUBLIC_FARO_APP_KEY). It only keeps out stray clients.
FARO_ALLOWED_ORIGIN=https://rentanllm.vercel.app
FARO_APP_KEY=change-me-faro-app-key

# Every-minute scheduler for the API's /cron/tick (Vercel Hobby
# only runs crons daily). API_CRON_ORIGIN is the API project's own URL, e.g.
# https://rentanllm-api.vercel.app; leave empty to disable. CRON_SECRET must equal
# the API's CRON_SECRET.
API_CRON_ORIGIN=
CRON_SECRET=

# Grafana login at https://grafana.<DOMAIN>.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
# Where alerts go: any webhook (Slack/Discord-compatible incoming webhook URL, ntfy, etc.).
GRAFANA_ALERT_WEBHOOK_URL=https://hooks.example.com/replace-me
