# Copy to gateway.env next to compose.yaml. Passed straight into the gateway container.
# Never commit gateway.env. Variables owned by the stack (PORT, HOST, LOG_FORMAT,
# REDIS_URL, OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_SERVICE_NAME, DEPLOY_ENV, GATEWAY_VERSION,
# GATEWAY_PUBLIC_URL) are set in compose.yaml and override anything here.
# The authoritative list is the Environment table in apps/gateway/README.md.

# Stores. The image defaults to STORE=postgres, which needs DATABASE_URL (Redis is wired by compose).
STORE=postgres
# Neon pooled connection string (Vercel Marketplace integration).
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/rentanllm?sslmode=require
# DB_MAX_CONNECTIONS=5

# Market payments settle on Hedera testnet through the x402 facilitator.
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_FACILITATOR_TIMEOUT_MS=30000
# X402_MAX_TIMEOUT_SECONDS=300

# Tuning (defaults shown).
# GATEWAY_CANCEL_USAGE_WAIT_MS=2000
# GATEWAY_HEAD_TIMEOUT_MS=120000
# GATEWAY_NODE_HELLO_TIMEOUT_MS=10000
# GATEWAY_MAX_BODY_BYTES=10485760
# GATEWAY_AUTH_CACHE_TTL_MS=5000
# GATEWAY_CREDIT_CACHE_TTL_SECONDS=60
# GATEWAY_CONCURRENCY_LEASE_MS=600000
# GATEWAY_METER_PERSIST_INTERVAL_MS=30000

# Local smoke test only: in-memory stores seeded from the image's dev fixture.
# Never use this in production.
# STORE=memory
# GATEWAY_SEED_FILE=/app/fixtures/dev-seed.json
